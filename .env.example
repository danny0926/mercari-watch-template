# Copy to .env. Real search terms and credentials belong only in .env / GitHub Secrets.
# Keep JSON on one line. [] disables monitoring until you provide your own rules.
WATCHLIST_JSON='[]'
# Rule sources: jp, tw, yahoo_fleamarket, surugaya. Auction websites are excluded.
# Mercari auction items are excluded by default (include_auctions=false).
# Optional rule fields: must_match_anywhere / must_not_match_anywhere (title/details regexes),
# review_unconfirmed=false keeps confirmed text matches; true opts into unconfirmed candidates.
# catchup_ids=[] selects explicit one-time catchup items.
# tw is Mercari's cross-border Taiwan storefront, not a local-stock comparison.
DISCORD_WEBHOOK_URL=
# Optional independent destination; select it with a rule's discord_webhook_env.
DISCORD_WEBHOOK_URL_SECONDARY=
# Optional third independent destination; select it with a rule's discord_webhook_env.
DISCORD_WEBHOOK_URL_TERTIARY=
# original uses Mercari's explicit /ja/ native item links; buyee selects a proxy service.
# Switching to a proxy does not fix Mercari's own regional redirection.
MERCARI_LINK_MODE=original
# Optional private references for Check workflow state_audit; never stores rules publicly.
MONITOR_AUDIT_JSON=[]
# Primary: project-local CloakBrowser in headless mode. Run setup-cloakbrowser.py first.
# patchright is a manual headed alternative; there is no automatic visible fallback.
SURUGAYA_BROWSER_BACKEND=cloakbrowser
CLOAKBROWSER_CACHE_DIR=.state/cloakbrowser
CLOAKBROWSER_VERSION=146.0.7680.177.5
CLOAKBROWSER_AUTO_UPDATE=false
# Optional headed Patchright channel: msedge on Windows, chrome on Linux.
SURUGAYA_BROWSER_CHANNEL=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# Generate with the README command; keep the same key between scheduled runs.
MONITOR_STATE_KEY=
MONITOR_STATE_PATH=.state/seen.enc
# Local launcher only; explicitly select your fork, never infer the upstream repo.
MONITOR_GITHUB_REPOSITORY=
LOCAL_MONITOR_INTERVAL_SECONDS=1800
